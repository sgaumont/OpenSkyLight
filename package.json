{
  "name": "openskylight",
  "version": "0.8.176",
  "description": "OpenSkyLight — an open-source standalone family calendar display (Skylight Calendar clone)",
  "main": "./out/main/index.js",
  "author": "Tyler",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:windowed": "electron-vite dev -- --windowed",
    "dev:companion": "vite --config companion.vite.config.ts",
    "build": "electron-vite build && npm run build:companion",
    "build:companion": "vite build --config companion.vite.config.ts",
    "android": "node scripts/build-android.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && node scripts/build-android.mjs --bundle && electron-builder",
    "postdist": "node scripts/copy-kiosk-exe.mjs",
    "release": "npm run build && node scripts/build-android.mjs --bundle --require && electron-builder --publish always"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@googleapis/calendar": "^15.0.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.38.4",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.8.0",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^10.7.0",
    "ical.js": "^2.2.1",
    "luxon": "^3.5.0",
    "mpegts.js": "^1.8.0",
    "rrule": "^2.8.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.66.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "playwright-core": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-simple-keyboard": "^3.8.27",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "zustand": "^5.0.3"
  }
}
